{
  "manifest_version": 3,
  "name": "PDF Smith",
  "version": "1.2.0",
  "description": "Reorder, rotate, add text, merge, and compress PDFs to a target file size — entirely in your browser.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/anamsimon/pdf-smith",
  "action": {
    "default_title": "Open PDF Smith",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads"
  ]
}
